    },
    {
      "id": "Hv-FiMEdLYyCAljOI8WKz",
      "type": "text",
      "x": -2080,
      "y": -700,
      "width": 625.9939156105991,
      "height": 960,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0U",
      "roundness": null,
      "seed": 2054087065,
      "version": 158,
      "versionNonce": 891406169,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779171539741,
      "link": null,
      "locked": false,
      "text": "Application Record Statuses\n\n1. Draft\n   Created by contractor.\n   Editable by contractor.\n   Not yet submitted.\n   Can exist offline.\n\n2. Submitted\n   Contractor has attested.\n   Contractor should not freely edit it anymore.\n   Waiting for sync or manager review.\n\n3. Pending Review\n   Manager can inspect it.\n   Contractor can no longer modify it directly.\n\n4. Needs Correction\n   Manager found missing/incorrect information.\n   Contractor may submit a corrected version.\n   Original submitted version should remain preserved.\n\n5. Accepted\n   Manager accepts the record as complete enough.\n\n6. Locked\n   Record becomes immutable.\n   Used for audit/export.\n\n7. Exported\n   Record has been included in a report/export package.: ",
      "fontSize": 24.7741935483871,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Application Record Statuses\n\n1. Draft\n   Created by contractor.\n   Editable by contractor.\n   Not yet submitted.\n   Can exist offline.\n\n2. Submitted\n   Contractor has attested.\n   Contractor should not freely edit it anymore.\n   Waiting for sync or manager review.\n\n3. Pending Review\n   Manager can inspect it.\n   Contractor can no longer modify it directly.\n\n4. Needs Correction\n   Manager found missing/incorrect information.\n   Contractor may submit a corrected version.\n   Original submitted version should remain preserved.\n\n5. Accepted\n   Manager accepts the record as complete enough.\n\n6. Locked\n   Record becomes immutable.\n   Used for audit/export.\n\n7. Exported\n   Record has been included in a report/export package.: ",
      "autoResize": true,
      "lineHeight": 1.25
    },
