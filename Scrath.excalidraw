    {
      "id": "LgOaDK8WPZ0BfHVYHVDla",
      "type": "text",
      "x": 640,
      "y": -800,
      "width": 841.078857421875,
      "height": 775,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2S",
      "roundness": null,
      "seed": 188546871,
      "version": 345,
      "versionNonce": 1447153817,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779171335668,
      "link": null,
      "locked": false,
      "text": "Applicator name required\nFarm required\nField required\nCrop or site required\nAcres treated required\nProduct name required\nEPA registration number required unless product not found\nApplication date required\nStart time required\nApplication method required\nRate applied required\nTotal amount applied required\nTemperature required\nWind speed required\nWind direction required\nAttestation confirmation required\nCertification number required if RUP status is yes\nManager review required if RUP status is unknown\n\nImportant: “unknown” should not block record creation. It should block automatic acceptance.\n\nRUP = yes\n→ require certification number\n\nRUP = no\n→ normal flow\n\nRUP = unknown\n→ allow submit\n→ force manager review\n→ mark record as compliance uncertainty",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Applicator name required\nFarm required\nField required\nCrop or site required\nAcres treated required\nProduct name required\nEPA registration number required unless product not found\nApplication date required\nStart time required\nApplication method required\nRate applied required\nTotal amount applied required\nTemperature required\nWind speed required\nWind direction required\nAttestation confirmation required\nCertification number required if RUP status is yes\nManager review required if RUP status is unknown\n\nImportant: “unknown” should not block record creation. It should block automatic acceptance.\n\nRUP = yes\n→ require certification number\n\nRUP = no\n→ normal flow\n\nRUP = unknown\n→ allow submit\n→ force manager review\n→ mark record as compliance uncertainty",
      "autoResize": true,
      "lineHeight": 1.25
    },
