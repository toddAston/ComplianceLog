# FieldLog API — server-side environment. Copy to .env for local compose.
# NOTHING here is baked into the container image; every value is read at startup.
# Real secrets in prod come from the platform secret manager (see api_architecture.md §12).

# --- Runtime ---
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# --- Postgres (system of record) ---
# In compose this is overridden to point at the `postgres` service host.
DATABASE_URL=postgresql://fieldlog:CHANGE_ME_LOCAL_DB_PW@postgres:5432/fieldlog
POSTGRES_USER=fieldlog
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DB_PW
POSTGRES_DB=fieldlog

# --- Redis (rate-limit store + BullMQ broker) ---
REDIS_URL=redis://redis:6379

# --- Auth / sessions ---
# 32+ byte random strings. Generate with: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_AT_LEAST_32_BYTES
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_AT_LEAST_32_BYTES
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_AT_LEAST_32_BYTES
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- argon2id work factors (see api_architecture.md §2) ---
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Rate limits (auth endpoints) ---
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=1m

# --- Object storage for exported PDFs (signed URLs) ---
# Stubbed in the skeleton; real values when the export job is implemented.
EXPORT_BUCKET=
EXPORT_SIGNED_URL_TTL_SECONDS=900
