# Base URL used to construct contractor invite links. The invite token is
# appended as a path segment, e.g. ${VITE_INVITE_BASE_URL}/<token>. Trailing
# slashes are stripped. Leave unset to use the default placeholder
# (https://fieldlog.invite) — v0.1 invite stubs are not yet wired to a real
# recipient flow, so this is a display-only URL.
VITE_INVITE_BASE_URL=localhost:5173
